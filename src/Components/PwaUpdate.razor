@inherits MudComponentBase
@using PatrickJahr.Blazor.PwaUpdate.Services
@inject IUpdateService UpdateService

@if (_newVersionAvailable)
{
    <MudAlert Class="mb-4" Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">
        <MudStack Spacing="2">
            <MudText>A new version is available!</MudText>
            <MudButton Variant="Variant.Outlined" OnClick="@UpdatePwaVersion">Update now</MudButton>
        </MudStack>
    </MudAlert>
}